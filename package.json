{
  "name": "zengate",
  "version": "1.1.1",
  "description": "Keyless OpenAI-compatible API (Chat Completions + Responses) for OpenCode's free Zen models, served through the real OpenCode CLI.",
  "author": {
    "name": "developingchet",
    "url": "https://github.com/developingchet"
  },
  "homepage": "https://github.com/developingchet/zengate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developingchet/zengate.git"
  },
  "bugs": {
    "url": "https://github.com/developingchet/zengate/issues"
  },
  "main": "index.js",
  "type": "module",
  "bin": {
    "zengate": "index.js"
  },
  "files": [
    "index.js",
    "src/",
    "scripts/setup.mjs",
    "config.json.example"
  ],
  "scripts": {
    "start": "node index.js",
    "setup": "node scripts/setup.mjs",
    "lint": "node scripts/quality.mjs",
    "test": "node --test \"test/**/*.test.mjs\" \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.mjs\" \"test/**/*.test.js\"",
    "test:live": "node scripts/live-e2e.mjs",
    "verify": "npm run lint && npm test",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "opencode",
    "openai",
    "zen",
    "keyless",
    "proxy",
    "gateway",
    "chat-completions",
    "responses-api",
    "openai-compatible",
    "llm",
    "api-gateway",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "opencode-ai": "1.18.32"
  },
  "overrides": {
    "es-define-property": "npm:@socketregistry/es-define-property@^1",
    "safer-buffer": "npm:@socketregistry/safer-buffer@^1",
    "side-channel": "npm:@socketregistry/side-channel@^1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
